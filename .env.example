# Copy to .env to override defaults. Every setting is optional.
# The Melbourne Open Data API needs no credentials.

# PEDESTRIAN_DATABASE_PATH=data/pedestrian.duckdb
# PEDESTRIAN_API_BASE_URL=https://data.melbourne.vic.gov.au/api/explore/v2.1/catalog/datasets
# PEDESTRIAN_COUNTS_DATASET=pedestrian-counting-system-past-hour-counts-per-minute
# PEDESTRIAN_SENSORS_DATASET=pedestrian-counting-system-sensor-locations
# PEDESTRIAN_REQUEST_TIMEOUT_SECONDS=90
# PEDESTRIAN_MAX_RETRIES=4
# PEDESTRIAN_BACKOFF_BASE_SECONDS=1.0
